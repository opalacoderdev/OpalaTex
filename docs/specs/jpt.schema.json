{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.opalacoder.com/schemas/jpt-1.schema.json",
  "title": "OpalaTex presentation (.jpt), format version 1",
  "description": "Describes what a conforming WRITER emits. The reader in gui_src/src/slides/model.js is deliberately more permissive and repairs rather than rejects: see jpt_format.md §7. Unknown keys are legal everywhere by design (invariant I2), so every object here sets additionalProperties: true.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "version",
    "title",
    "width",
    "height",
    "theme",
    "slides"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "title": {
      "type": "string"
    },
    "width": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "height": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "theme": {
      "$ref": "#/$defs/theme"
    },
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/slide"
      }
    }
  },
  "$defs": {
    "theme": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "background",
        "backgroundImage",
        "backgroundFit",
        "backgroundOpacity",
        "color",
        "accent",
        "fontFamily"
      ],
      "properties": {
        "background": {
          "type": "string"
        },
        "backgroundImage": {
          "type": [
            "string",
            "null"
          ],
          "description": "A picture drawn over the colour on every slide that does not override it"
        },
        "backgroundFit": {
          "enum": [
            "cover",
            "contain",
            "fill"
          ]
        },
        "backgroundOpacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "color": {
          "type": "string"
        },
        "accent": {
          "type": "string"
        },
        "fontFamily": {
          "type": "string"
        },
        "headerHeight": {
          "type": "number",
          "minimum": 0,
          "description": "Height of the band drawn behind a slide title; 0 for none"
        },
        "headerColor": {
          "type": [
            "string",
            "null"
          ],
          "description": "null uses the accent"
        },
        "titleColor": {
          "type": [
            "string",
            "null"
          ],
          "description": "null uses the ordinary text colour"
        },
        "footerHeight": {
          "type": "number",
          "minimum": 0
        },
        "footerColor": {
          "type": [
            "string",
            "null"
          ]
        },
        "footerTextColor": {
          "type": [
            "string",
            "null"
          ]
        },
        "footerText": {
          "enum": [
            "",
            "title"
          ],
          "description": "'title' puts the deck title and slide number in the footer band"
        }
      }
    },
    "slide": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "id",
        "background",
        "backgroundImage",
        "backgroundFit",
        "backgroundOpacity",
        "notes",
        "elements"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "background": {
          "type": [
            "string",
            "null"
          ],
          "description": "null inherits theme.background"
        },
        "backgroundImage": {
          "type": [
            "string",
            "null"
          ],
          "description": "\"\" inherits the theme's picture, null is an explicit none, a string is this slide's own"
        },
        "backgroundFit": {
          "enum": [
            "cover",
            "contain",
            "fill"
          ]
        },
        "backgroundOpacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "notes": {
          "type": "string"
        },
        "elements": {
          "type": "array",
          "description": "Paint order: later elements are drawn on top",
          "items": {
            "$ref": "#/$defs/element"
          }
        }
      }
    },
    "element": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "id",
        "type",
        "x",
        "y",
        "w",
        "h",
        "rotation",
        "opacity"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "text",
            "equation",
            "image",
            "video",
            "shape"
          ]
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "w": {
          "type": "number",
          "minimum": 1
        },
        "h": {
          "type": "number",
          "minimum": 1
        },
        "rotation": {
          "type": "number"
        },
        "opacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "text"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/textPayload"
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "equation"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/equationPayload"
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "image"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/imagePayload"
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "video"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/videoPayload"
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "shape"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/shapePayload"
          }
        }
      ]
    },
    "textPayload": {
      "required": [
        "text",
        "role",
        "bullet",
        "fontSize",
        "fontFamily",
        "color",
        "bold",
        "italic",
        "underline",
        "align",
        "valign",
        "lineHeight"
      ],
      "properties": {
        "text": {
          "type": "string"
        },
        "fontSize": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "fontFamily": {
          "type": [
            "string",
            "null"
          ]
        },
        "color": {
          "type": [
            "string",
            "null"
          ]
        },
        "bold": {
          "type": "boolean"
        },
        "italic": {
          "type": "boolean"
        },
        "underline": {
          "type": "boolean"
        },
        "align": {
          "enum": [
            "left",
            "center",
            "right"
          ]
        },
        "valign": {
          "enum": [
            "top",
            "middle",
            "bottom"
          ]
        },
        "lineHeight": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "role": {
          "enum": [
            null,
            "title"
          ],
          "description": "A title follows the theme's title colour and sits in the header band"
        },
        "bullet": {
          "enum": [
            null,
            "disc",
            "dash",
            "number"
          ],
          "description": "The list marker drawn in front of every non-empty line, or null for none. Per box; the nesting level of a line is the number of tab characters in front of it, capped at 4."
        }
      }
    },
    "equationPayload": {
      "required": [
        "latex",
        "displayMode",
        "fontSize",
        "color"
      ],
      "properties": {
        "latex": {
          "type": "string",
          "description": "KaTeX-compatible LaTeX. The source, never a rendered picture of it."
        },
        "displayMode": {
          "type": "boolean"
        },
        "fontSize": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "color": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "imagePayload": {
      "required": [
        "src",
        "alt",
        "fit"
      ],
      "properties": {
        "src": {
          "type": "string",
          "description": "A data: URI, an http(s) URL, or a path relative to the project root"
        },
        "alt": {
          "type": "string"
        },
        "fit": {
          "enum": [
            "contain",
            "cover",
            "fill"
          ]
        }
      }
    },
    "videoPayload": {
      "required": [
        "src",
        "poster",
        "alt",
        "fit",
        "autoplay",
        "loop",
        "muted",
        "controls",
        "start"
      ],
      "properties": {
        "src": {
          "type": "string",
          "minLength": 1,
          "description": "A link to a video page (YouTube, Vimeo), or a video file: a data: URI, an http(s) URL, or a path relative to the project root. Which of the two it is is derived from the string, never stored separately."
        },
        "poster": {
          "type": "string",
          "description": "A still shown wherever the video cannot play — the editing canvas, the thumbnail rail, a PDF export. '' for none."
        },
        "alt": {
          "type": "string"
        },
        "fit": {
          "enum": [
            "contain",
            "cover",
            "fill"
          ]
        },
        "autoplay": {
          "type": "boolean",
          "description": "Start when the slide is shown in presentation mode. Browsers block an unmuted autoplay, so this implies muted playback."
        },
        "loop": {
          "type": "boolean"
        },
        "muted": {
          "type": "boolean"
        },
        "controls": {
          "type": "boolean"
        },
        "start": {
          "type": "number",
          "minimum": 0,
          "description": "Seconds into the video to begin at."
        }
      }
    },
    "shapePayload": {
      "required": [
        "shape",
        "fill",
        "stroke",
        "strokeWidth",
        "radius"
      ],
      "properties": {
        "shape": {
          "enum": [
            "rect",
            "ellipse",
            "triangle",
            "line",
            "arrow"
          ]
        },
        "fill": {
          "type": "string"
        },
        "stroke": {
          "type": [
            "string",
            "null"
          ]
        },
        "strokeWidth": {
          "type": "number",
          "minimum": 0
        },
        "radius": {
          "type": "number",
          "minimum": 0
        },
        "arrowStart": {
          "type": "boolean"
        },
        "arrowEnd": {
          "type": "boolean"
        }
      }
    }
  }
}
