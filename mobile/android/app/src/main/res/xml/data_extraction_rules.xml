<?xml version="1.0" encoding="utf-8"?>
<!--
  Nothing is backed up or transferred. API keys are encrypted with a Keystore
  key that never leaves this device, so a restored copy could not be read, and
  the conversation cache is rebuilt from Google Drive.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
