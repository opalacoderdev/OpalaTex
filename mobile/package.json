{
  "name": "opalatex-mobile",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "OpalaTex mobile companion: chats and project files mirrored through Google Drive.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "node --test src/**/__tests__/*.test.js",
    "android:sync": "vite build && cap sync android",
    "android:debug": "vite build && cap sync android && cd android && ./gradlew assembleDebug",
    "android:release": "vite build && cap sync android && cd android && ./gradlew bundleRelease assembleRelease",
    "test:browser": "python3 test/browser/run.py"
  },
  "dependencies": {
    "@capacitor/android": "8.5.2",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.5.2",
    "@capacitor/network": "8.0.1",
    "@capacitor/preferences": "8.0.1",
    "i18next": "26.3.1",
    "katex": "0.18.1",
    "lucide-react": "0.378.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-i18next": "17.0.8",
    "react-markdown": "10.1.0",
    "react-pdf": "10.4.1",
    "rehype-katex": "7.0.1",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "@vitejs/plugin-react-swc": "4.3.1",
    "vite": "8.3.0"
  }
}
