#!/bin/sh
set -eu

export PYTHONUTF8="${PYTHONUTF8:-1}"
export PYTHONIOENCODING="${PYTHONIOENCODING:-utf-8}"
export PYWEBVIEW_GUI="${PYWEBVIEW_GUI:-qt}"
export QT_API="${QT_API:-pyqt6}"
export QTWEBENGINE_DISABLE_SANDBOX="${QTWEBENGINE_DISABLE_SANDBOX:-1}"
export PATH="$SNAP/bin:$SNAP/usr/bin:$PATH"

# espeak-ng resolves its data directory from a path compiled into the library
# (/usr/lib/<triplet> on Debian and Ubuntu), which inside confinement points at
# the base snap and holds nothing. ESPEAK_DATA_PATH names the *parent* of
# espeak-ng-data, and espeak-ng prefers it over the compiled-in path, so the
# staged copy is found without hardcoding an architecture triplet here.
if [ -z "${ESPEAK_DATA_PATH:-}" ]; then
    for espeak_data in "$SNAP"/usr/lib/*/espeak-ng-data "$SNAP"/usr/share/espeak-ng-data; do
        if [ -d "$espeak_data" ]; then
            ESPEAK_DATA_PATH="$(dirname "$espeak_data")"
            export ESPEAK_DATA_PATH
            break
        fi
    done
fi

exec "$SNAP/bin/python" -m opalatex.cli --gui "$@"
